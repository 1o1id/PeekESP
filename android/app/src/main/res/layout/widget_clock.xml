<?xml version="1.0" encoding="utf-8"?>
<!--
  The live part of the clock page. A bitmap on a widget is redrawn every 15 minutes,
  so the digits are a native TextClock instead: the system keeps it right to the
  minute, follows the 12/24-hour setting and the time zone, and costs the app nothing.
  Sizes and padding are set from code (ClockOverlay) to match the card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/clock_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/peek_text"
            android:textSize="36sp" />

        <!-- Empty in 24-hour mode. -->
        <TextClock
            android:id="@+id/clock_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="a"
            android:format24Hour=""
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/peek_dim"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>